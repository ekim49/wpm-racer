{
  "name": "wpm-racer",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.11.0",
  "type": "module",
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && node --input-type=module -e \"import fs from 'node:fs'; fs.mkdirSync('dist/data',{recursive:true}); fs.copyFileSync('src/data/prompts.json','dist/data/prompts.json');\"",
    "start": "node dist/index.js",
    "test": "node --import tsx --test src/features/engine/wpm-calculator.test.ts"
  },
  "dependencies": {
    "ansi-escapes": "^7.0.0",
    "chalk": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3"
  },
  "engines": {
    "node": ">=20"
  }
}
